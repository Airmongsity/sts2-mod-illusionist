{
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.ancient": "You brought others.",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.next": "Answer",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.char": "They are all me.",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.next": "Continue",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-2.ancient": "Then there is too much of you.",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-0r.ancient": "Which of you is speaking?",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-0r.next": "Answer",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-1r.char": "Does it matter?",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-1r.next": "Continue",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-2r.ancient": "Everything belongs somewhere.\nEven you.",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0r.ancient": "Put out that lamp.\nI am trying to keep things still.",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0r.next": "Refuse",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1r.char": "I would rather see.",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1r.next": "Continue",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-2r.ancient": "There is nothing here worth seeing.",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.3-0r.ancient": "I unmade you the last time.",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.3-0r.next": "Admit",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.3-1r.char": "You did.\nI remember.",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.3-1r.next": "Continue",
  "THE_ARCHITECT.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.3-2r.ancient": "[jitter][red]THEN STAND STILL.[/red][/jitter]",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.ancient": "[sine]..I remade.. ..one of you...[/sine]",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.next": "Answer",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.char": "The others came anyway.",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.next": "Continue",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-2.ancient": "[sine]...good.... ..more hands....[/sine]",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-0r.ancient": "[sine]..still.. ..bringing.. ..company...[/sine]",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.ancient": "[sine]..which one.. ..did I.. ..bring back...?[/sine]",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.next": "Answer",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.char": "You never say.",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.next": "Continue",
  "NEOW.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-2.ancient": "[sine]...neither.. ..do you....[/sine]",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.ancient": "Well now! Ain’t seen one of you before.\n...or is it five of ya?",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.next": "Answer",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.char": "Nine, when it goes well.",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.next": "Continue",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-2.ancient": "Ha! Then take nine things!\n...no wait. Take one.",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-0r.ancient": "Still bringin’ the whole crowd, eh?\nDon’t let ’em touch the shelves!",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.ancient": "That lamp of yours. I’d trade ya somethin’ real nice for it.",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.next": "Refuse",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.char": "No.",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.next": "Continue",
  "DARV.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-2.ancient": "Heh. Everythin’ ends up in my collection eventually.",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.ancient": "Many!? How many!! All same face!\nWhich real??",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.next": "Answer",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.char": "All of them.",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.next": "Continue",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-2.ancient": "[jitter]All real!?[/jitter] Wonderful!!\nTake shiny! Take many shiny!!",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-0r.ancient": "Crowd again! Hello hello hello!!\nHello to all!",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.ancient": "Nine you! Nine lonely??\nOr nine not lonely!?",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.next": "Answer",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.char": "I have not decided.",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.next": "Continue",
  "OROBAS.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-2.ancient": "Take time! Thinking good!! Very good!",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.ancient": "[thinky_dots]So many of you, and all so quiet.\nRestful...[/thinky_dots]",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.next": "Answer",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.char": "We try not to wake things.",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.next": "Continue",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-2.ancient": "[thinky_dots]Take a part of me.\nAny of you may carry it...[/thinky_dots]",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-0r.ancient": "[thinky_dots]The quiet crowd returns.\nDid you sleep at all...?[/thinky_dots]",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.ancient": "[thinky_dots]Do your reflections dream?[/thinky_dots]",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.next": "Answer",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.char": "I have never asked them.",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.next": "Continue",
  "PAEL.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-2.ancient": "[thinky_dots]Ask them.\nThey have been waiting all this time...[/thinky_dots]",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.ancient": "A contract requires a signature.\nWhich of you holds the pen?",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.next": "Answer",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.char": "Any of us can write.",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.next": "Continue",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-2.ancient": "Then any of you can be held to it.",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-0r.ancient": "Back again. Still no idea which one of you owes me.",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.ancient": "I have dealt with liars before.\nYou are something worse. You are [sine]several[/sine].",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.next": "Reply",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.char": "That is not my problem.",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.next": "Continue",
  "VAKUU.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-2.ancient": "[i][font_size=22]Vakuu makes a note.[/font_size][/i]",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.ancient": "Come in, dear! And bring your [jitter][b]friends[/b][/jitter]!",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.next": "Answer",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.char": "They go where I go.",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.next": "Continue",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-2.ancient": "How [jitter][b]obedient[/b][/jitter].",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-0r.ancient": "Back so soon, sweetie?\nSit, sit — all of you!",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.ancient": "That little lamp.\nLet me make it [jitter][b]bigger[/b][/jitter].",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.next": "Refuse",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.char": "It is the right size.",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.next": "Continue",
  "TEZCATARA.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-2.ancient": "Everyone says that.\n[i][font_size=22]Tezcatara smiles.[/font_size][/i]",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.ancient": "NINE WARRIORS!? MIGHTY DAY!!",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.next": "Correct",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.char": "One. The rest are me.",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.next": "Continue",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-2.ancient": "EVEN BETTER!! FIGHT YOURSELF!! MIGHTY!!",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-0r.ancient": "A LAMP IS NOT A WEAPON!!",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.ancient": "FIGHT ME, ILLUSIONIST!!",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.next": "Fight",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.char": "[i][font_size=22]Nine Illusionists step forward. Tanx cannot tell which one strikes.[/font_size][/i]",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.next": "Continue",
  "TANX.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-2.ancient": "BEST FIGHT!! WHICH ONE WON!?",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.ancient": "A visitor, and she has brought an [sine]audience[/sine].",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-0.next": "Answer",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.char": "They only look where I look.",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-1.next": "Continue",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.0-2.ancient": "Then have them look here.\nCome, let us dress you properly.",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.1-0r.ancient": "My favorite guest — and all of her.",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.ancient": "Nine of you, and not one has complimented my robes.",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-0.next": "Answer",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.char": "They are very fine.",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-1.next": "Continue",
  "NONUPEIPE.talk.ILLUSIONIST_CHARACTER_ILLUSIONIST.2-2.ancient": "...from all nine, if you please."
}
